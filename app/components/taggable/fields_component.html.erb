<div class="js-taggable-fields">
  <div class="taggable-fields-heading<%= " taggable-fields-heading-with-suggest" if show_ai_suggestions? %>">
    <%= form.label :tag_list, tags_label, class: ("h4" if show_ai_suggestions?) %>
    <% if show_ai_suggestions? %>
      <button type="button"
              class="button hollow js-suggest-classification"
              data-resource-type="<%= suggest_button_data[:resource_type] %>"
              <% if suggest_button_data[:resource_id] %>
                data-resource-id="<%= suggest_button_data[:resource_id] %>"
              <% end %>>
        <%= t("classification_suggestions.suggest_tags") %>
      </button>
    <% end %>
  </div>
  <p class="help-text" id="tag-list-help-text"><%= tags_instructions %></p>

  <% if categories.any? %>
    <div id="category_tags" class="tags">
      <%= form.label :category_tag_list, tag_category_label %>
      <% categories.each do |category| %>
        <% name = category_name(category) %>
        <% checkbox_id = "tag_category_#{name.parameterize}" %>
        <%= check_box_tag nil, name, category_selected?(name),
                          id: checkbox_id,
                          class: "js-tag-category",
                          data: { list_value: name } %>
        <%= label_tag checkbox_id, name %>
      <% end %>
    </div>

    <br>
  <% end %>

  <%= form.text_field :tag_list, value: tag_list_value,
                                 label: false,
                                 placeholder: tags_placeholder,
                                 class: "js-tag-list",
                                 aria: { describedby: "tag-list-help-text" },
                                 data: tag_list_data %>

  <% if show_ai_suggestions? %>
    <div class="js-classification-suggestions-tags help-section callout primary hide"
         role="region"
         aria-label="<%= t("classification_suggestions.tags_region") %>"
         data-title="<%= t("classification_suggestions.tags_title") %>"
         data-accept-all="<%= t("classification_suggestions.accept_all") %>"
         data-loading="<%= t("classification_suggestions.loading") %>"
         data-empty="<%= t("classification_suggestions.empty") %>"
         data-error="<%= t("classification_suggestions.error") %>">
      <div class="js-classification-suggestions-body"></div>
    </div>
  <% end %>
</div>
